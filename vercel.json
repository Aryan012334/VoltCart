      "source": "/((?!static/|favicon\\.ico|favicon-.*\\.png|apple-touch-icon\\.png|android-chrome-.*\\.png|voltcart-mark\\.svg|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
